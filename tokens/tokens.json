{
  "name": "SecureGate Design Tokens",
  "version": "1.0.0",
  "description": "Design tokens for SecureGate — a focused, production-grade authentication system. Light-canvas-only by design. Black-and-white chrome with a small semantic palette reserved for in-product form validation.",
  "colors": {
    "brand": {
      "primary": { "value": "#000000", "type": "color", "description": "The brand. Every primary CTA, every link in nav, every solid icon." },
      "ink-deep": { "value": "#090909", "type": "color", "description": "Pressed-state black for the primary pill." }
    },
    "surface": {
      "canvas": { "value": "#ffffff", "type": "color", "description": "The page itself. Nearly every surface in the system." },
      "surface-soft": { "value": "#fafafa", "type": "color", "description": "Code-snippet pill background, search pill, secondary chips." },
      "surface-dark": { "value": "#171717", "type": "color", "description": "The dark Max pricing card and dark CTA strips — the only inverted surface." },
      "hairline": { "value": "#e5e5e5", "type": "color", "description": "1px card border, divider line, FAQ row divider." },
      "hairline-strong": { "value": "#d4d4d4", "type": "color", "description": "Slightly stronger divider where extra separation is needed." }
    },
    "text": {
      "ink": { "value": "#000000", "type": "color", "description": "Headlines, primary nav links, button text on light surfaces." },
      "charcoal": { "value": "#525252", "type": "color", "description": "List-item text, disabled secondary copy." },
      "body": { "value": "#737373", "type": "color", "description": "Default body color for paragraphs, FAQ answers, footer text." },
      "mute": { "value": "#a3a3a3", "type": "color", "description": "Captions, comment-gray inside terminal mockups." },
      "on-primary": { "value": "#ffffff", "type": "color", "description": "Text on the primary black pill." },
      "on-dark": { "value": "#ffffff", "type": "color", "description": "Primary text on surface-dark." },
      "on-dark-mute": { "value": "rgba(255, 255, 255, 0.7)", "type": "color", "description": "Secondary copy inside the dark Max pricing card." }
    },
    "semantic": {
      "error": { "value": "#dc2626", "type": "color", "description": "Invalid-input border, validation error text. Form validation only." },
      "error-soft": { "value": "#fef2f2", "type": "color", "description": "Error message background fill (rare)." },
      "success": { "value": "#16a34a", "type": "color", "description": "Password-strength 'strong', verified badge, success toast." },
      "warning": { "value": "#ca8a04", "type": "color", "description": "Password-strength 'fair', token-expiring notice." },
      "info-mute": { "value": "#525252", "type": "color", "description": "Neutral info messages — kept quiet, same value as charcoal." }
    },
    "terminal": {
      "terminal-red": { "value": "#ff5f56", "type": "color", "description": "Close-window dot inside terminal mockup." },
      "terminal-yellow": { "value": "#ffbd2e", "type": "color", "description": "Minimize dot." },
      "terminal-green": { "value": "#27c93f", "type": "color", "description": "Zoom dot." }
    },
    "focus": {
      "focus-ring": { "value": "rgba(59, 130, 246, 0.5)", "type": "color", "description": "Translucent blue browser-default focus ring." }
    }
  },
  "typography": {
    "font-family": {
      "display": {
        "value": ["SF Pro Rounded", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
        "type": "fontFamily",
        "description": "Display headings. SF Pro Rounded on Apple devices; system-ui everywhere else."
      },
      "sans": {
        "value": ["ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"],
        "type": "fontFamily",
        "description": "Body, links, buttons, captions. System default sans."
      },
      "mono": {
        "value": ["ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "Liberation Mono", "Courier New", "monospace"],
        "type": "fontFamily",
        "description": "Code-snippet pill, terminal mockup, inline code."
      }
    },
    "scale": {
      "display-xl": { "fontSize": "36px", "fontWeight": 500, "lineHeight": 1.11, "letterSpacing": 0, "fontFamily": "display", "use": "Hero headline" },
      "display-lg": { "fontSize": "30px", "fontWeight": 500, "lineHeight": 1.2, "letterSpacing": 0, "fontFamily": "display", "use": "Major section headlines, large prices" },
      "heading-lg": { "fontSize": "24px", "fontWeight": 600, "lineHeight": 1.33, "letterSpacing": 0, "fontFamily": "display", "use": "Section subheadings" },
      "heading-md": { "fontSize": "20px", "fontWeight": 500, "lineHeight": 1.4, "letterSpacing": 0, "fontFamily": "display", "use": "Pricing tier name, card title, form section header" },
      "heading-sm": { "fontSize": "18px", "fontWeight": 500, "lineHeight": 1.56, "letterSpacing": 0, "fontFamily": "sans", "use": "FAQ question, form field-group label" },
      "body-md": { "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": 0, "fontFamily": "sans", "use": "Default body, FAQ answers, form input value" },
      "body-strong": { "fontSize": "16px", "fontWeight": 500, "lineHeight": 1.5, "letterSpacing": 0, "fontFamily": "sans", "use": "Inline emphasis, form field label" },
      "body-sm": { "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.43, "letterSpacing": 0, "fontFamily": "sans", "use": "Feature bullet, footer link, helper text" },
      "body-sm-strong": { "fontSize": "14px", "fontWeight": 500, "lineHeight": 1.43, "letterSpacing": 0, "fontFamily": "sans", "use": "Button label, validation error message" },
      "caption-sm": { "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.33, "letterSpacing": 0, "fontFamily": "sans", "use": "Footer copyright, password-strength label" },
      "code-md": { "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": 0, "fontFamily": "mono", "use": "Code-snippet pill, terminal command" },
      "code-sm": { "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.43, "letterSpacing": 0, "fontFamily": "mono", "use": "Terminal output, inline code chip" },
      "button-md": { "fontSize": "14px", "fontWeight": 500, "lineHeight": 1, "letterSpacing": 0, "fontFamily": "sans", "use": "All button labels" }
    }
  },
  "spacing": {
    "base-unit": "8px",
    "scale": {
      "xxs": { "value": "2px", "type": "dimension" },
      "xs":  { "value": "4px", "type": "dimension" },
      "sm":  { "value": "8px", "type": "dimension" },
      "md":  { "value": "12px", "type": "dimension" },
      "lg":  { "value": "16px", "type": "dimension" },
      "xl":  { "value": "24px", "type": "dimension" },
      "xxl": { "value": "32px", "type": "dimension" },
      "section": { "value": "88px", "type": "dimension", "description": "Vertical gap between major content blocks (desktop)." },
      "section-tablet": { "value": "64px", "type": "dimension", "description": "Section gap at tablet breakpoint." },
      "section-mobile": { "value": "48px", "type": "dimension", "description": "Section gap at mobile breakpoint." }
    }
  },
  "rounded": {
    "none": { "value": "0px", "type": "dimension", "description": "Nav, footer, FAQ row dividers." },
    "sm":   { "value": "6px", "type": "dimension", "description": "Inline code chips, command tags." },
    "md":   { "value": "8px", "type": "dimension", "description": "Rare medium-radius surfaces (dropdowns)." },
    "lg":   { "value": "12px", "type": "dimension", "description": "Pricing cards, terminal mockup, auth-form card." },
    "full": { "value": "9999px", "type": "dimension", "description": "Every button, every pill input, traffic-light dots." }
  },
  "borders": {
    "width": {
      "hairline": { "value": "1px", "type": "dimension" },
      "focus": { "value": "2px", "type": "dimension" }
    }
  },
  "z-index": {
    "base": { "value": 0, "type": "number" },
    "nav": { "value": 10, "type": "number" },
    "dropdown": { "value": 20, "type": "number" },
    "overlay": { "value": 30, "type": "number" },
    "modal": { "value": 40, "type": "number" },
    "toast": { "value": 50, "type": "number" }
  },
  "breakpoints": {
    "mobile": { "value": "640px", "type": "dimension" },
    "tablet-narrow": { "value": "768px", "type": "dimension" },
    "tablet": { "value": "850px", "type": "dimension" },
    "desktop": { "value": "1024px", "type": "dimension" },
    "desktop-large": { "value": "1280px", "type": "dimension" }
  },
  "components": {
    "button": {
      "height": "36px",
      "padding-x": "20px",
      "padding-y": "8px",
      "radius": "9999px",
      "font": "button-md"
    },
    "input": {
      "height": "40px",
      "padding-x": "16px",
      "padding-y": "8px",
      "radius": "9999px",
      "border-width": "1px",
      "border-color": "hairline",
      "font": "body-md"
    },
    "search-pill": {
      "height": "36px",
      "padding-x": "16px",
      "radius": "9999px",
      "background": "surface-soft",
      "font": "body-sm"
    },
    "code-snippet-pill": {
      "height": "48px",
      "padding-x": "20px",
      "padding-y": "12px",
      "radius": "9999px",
      "background": "surface-soft",
      "font": "code-md",
      "description": "Signature element. Hero-level code preview pill."
    },
    "card": {
      "padding": "32px",
      "radius": "12px",
      "background": "canvas",
      "border": "1px solid hairline"
    },
    "auth-card": {
      "padding": "32px",
      "padding-mobile": "24px",
      "radius": "12px",
      "background": "canvas",
      "border": "1px solid hairline",
      "max-width": "440px"
    },
    "terminal-card": {
      "padding": "16px",
      "radius": "12px",
      "background": "canvas",
      "border": "1px solid hairline"
    },
    "terminal-traffic-light": {
      "size": "12px",
      "radius": "9999px",
      "gap": "4px"
    },
    "nav": {
      "height": "56px",
      "background": "canvas",
      "font": "body-sm-strong"
    },
    "password-strength": {
      "segment-count": 3,
      "segment-height": "4px",
      "radius": "9999px",
      "states": {
        "weak": { "filled-color": "error", "filled-count": 1 },
        "fair": { "filled-color": "warning", "filled-count": 2 },
        "strong": { "filled-color": "success", "filled-count": 3 }
      }
    }
  },
  "content": {
    "max-width-prose": "720px",
    "max-width-pricing-grid": "960px",
    "max-width-auth-card": "440px"
  },
  "animation": {
    "transition-fast": "120ms ease-out",
    "transition-base": "180ms ease-out"
  },
  "principles": {
    "shape-vocabulary": "Two values only — pill (9999px) for interactive elements, lg (12px) for cards. No medium-radius buttons, no full-radius cards.",
    "color-restraint": "Black-on-white system. Semantic palette is reserved strictly for in-product form validation; never used on marketing chrome.",
    "elevation": "No drop shadows anywhere. Cards lift via 1px hairline border OR inverted dark fill — never via shadow.",
    "primary-cta-rule": "At most one black-pill primary CTA per fold. The design's restraint is the design."
  }
}